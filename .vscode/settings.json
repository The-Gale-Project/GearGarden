{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/*.uid": true,
        "**/*.import": true
    },
	"[csharp]": {
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": { "source.organizeImports": "always" }
    },
    "godotTools.editorPath.godot4": "/usr/bin/godot-mono"
}
